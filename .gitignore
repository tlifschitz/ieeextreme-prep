*.out
*.out.dSYM
submit.py
__pycache__/
submit.cpp
*.bin
*.dSYM/
.cph/

# Tracked despite the patterns above: expected test outputs and the obfuscated packages.
!**/tests/**/*.out
!spoiler.bin
!data/techniques.bin

# Tutor state (per clone) and local copies of the reference books.
.tutor/
refs/local/

# Generated by scripts/publish.py from the spoiler rule (scripts/spoiler.py is_public_asset):
# everything a give-up installs into a problem folder stays out of `git add -A`, so a revealed
# solution is never committed or pushed by accident. attempt.py / attempt.cpp stay committable.
/contests/*/*/checker.py
/contests/*/*/gen.py
/contests/*/*/hints.json
/contests/*/*/HINTS.md
/contests/*/*/interactor.py
/contests/*/*/LEVELS.md
/contests/*/*/levels/
/contests/*/*/NOTES.md
/contests/*/*/reference.py
/contests/*/*/solution*
/contests/*/*/validate.py
# Builds of attempt.*
/contests/*/*/attempt
/contests/*/*/attempt.exe
/contests/*/*/attempt.o
/contests/*/*/attempt.dSYM/
/contests/*/*/a.out
